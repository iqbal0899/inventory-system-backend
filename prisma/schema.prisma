generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  INITIAL
  IN
  OUT
  ADJUSTMENT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestsCreated  Request[]       @relation("RequestCreator")
  requestsApproved Request[]       @relation("RequestApprover")
  stockMovements   StockMovement[]

  @@index([role])
  @@map("users")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  requests  Request[]
  purchases Purchase[]

  @@index([name])
  @@map("suppliers")
}

model Product {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  name        String
  description String?
  category    String?
  image       String?
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  minStock    Int           @default(0)
  unit        String        @default("pcs")
  status      ProductStatus @default(ACTIVE)

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  requestItems   RequestItem[]
  purchaseItems  PurchaseItem[]

  @@index([supplierId])
  @@index([name])
  @@index([status])
  @@index([category])
  @@map("products")
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  type        StockMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  note        String?

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  requestId String?
  request   Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  purchaseId Int?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([requestId])
  @@index([purchaseId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model Request {
  id                String        @id @default(cuid())
  requestNumber     String        @unique
  requesterUsername String?
  status            RequestStatus @default(PENDING)
  note              String?
  createdById       Int
  createdBy         User          @relation("RequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById      Int?
  approvedBy        User?         @relation("RequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  supplierId        Int?
  supplier          Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items          RequestItem[]
  stockMovements StockMovement[]

  @@index([createdById])
  @@index([approvedById])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("requests")
}

model RequestItem {
  id       Int     @id @default(autoincrement())
  quantity Int
  note     String?

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([requestId, productId])
  @@index([requestId])
  @@index([productId])
  @@map("request_items")
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model Purchase {
  id             Int            @id @default(autoincrement())
  purchaseNumber String         @unique
  supplierId     Int
  purchaseDate   DateTime       @default(now())
  status         PurchaseStatus @default(PENDING)
  totalAmount    Decimal        @db.Decimal(12, 2)
  note           String?
  cancelReason   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([supplierId])
  @@index([status])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         Int     @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}
